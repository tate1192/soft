<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_proforma_add_form_view" model="ir.ui.view">
        <field name="name">proforma.template.sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="after">
                <page string="Proforma" name="proforma" invisible="state == 'cancel'">
                    <p style="margin-top: 10px;">The proforma will be displayed on the printed document.</p>
                    <group>
                        <field name="sale_proforma_template_id"
                               string="Load a template"
                               domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]"
                               options="{'no_create':True}"/>
                        <field name="sale_proforma" nolabel="1" colspan="2" widget="html"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
