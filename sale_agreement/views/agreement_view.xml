<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="sale_agreement_template_search_view" model="ir.ui.view">
        <field name="name">sale.agreement.template.search</field>
        <field name="model">sale.agreement.template</field>
        <field name="arch" type="xml">
            <search string="Agreement Templates">
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="sale_agreement_template_form_view" model="ir.ui.view">
        <field name="name">sale.agreement.template.form</field>
        <field name="model">sale.agreement.template</field>
        <field name="arch" type="xml">
            <form string="Agreement Templates">
                <field name="active" invisible="1"/>
                <div class="oe_title pe-0">
                    <h1 class="d-flex justify-content-between align-items-center">
                        <div class="d-flex w-100">
                            <field name="priority" widget="priority" class="me-3"/>
                            <field name="name" class="o_task_name text-truncate w-100 w-md-75 pe-2"
                                   placeholder="Agreement Title..."/>
                        </div>
                    </h1>
                </div>
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="agreement" nolabel="1" colspan="2" widget="html"/>
                </group>
            </form>
        </field>
    </record>

    <record id="sale_agreement_template_list_view" model="ir.ui.view">
        <field name="name">sale.agreement.template.list</field>
        <field name="model">sale.agreement.template</field>
        <field name="arch" type="xml">
            <list string="Agreement Templates">
                <field name="priority" widget="priority" optional="show" nolabel="1" options="{'autosave': False}"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_sale_agreement_template" model="ir.actions.act_window">
        <field name="name">Agreement Templates</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.agreement.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="sale_agreement_template_list_view"/>
    </record>

    <menuitem
            name="Agreement Templates"
            id="menu_agreement_template_sale"
            action="sale_agreement.action_sale_agreement_template"
            parent="sale.menu_sale_config"
    />
</odoo>
