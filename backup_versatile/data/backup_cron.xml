<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Backup Scheduler Cron Job -->
        <record id="backup_cron" model="ir.cron">
            <field name="name">Database Versatile Backup Scheduler</field>
            <field name="model_id" ref="model_backup_config"/>
            <field name="state">code</field>
            <field name="code">model.run_scheduled_backups()</field>
            <field name="priority">5</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">False</field>
        </record>

        <!-- Backup Cleanup Cron Job -->
        <record id="backup_cleanup_cron" model="ir.cron">
            <field name="name">Database Versatile Backup Cleanup</field>
            <field name="model_id" ref="model_backup_config"/>
            <field name="state">code</field>
            <field name="code">
# Clean up old backups for all active configurations
configs = model.search([('active', '=', True)])
for config in configs:
    try:
        config.with_context(manual_execution=False).cleanup_old_backups()
    except Exception:
        log.exception("Cleanup failed for backup config '%s' (id=%s)", config.name, config.id)
            </field>
            <field name="priority">10</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
   
        <record id="backup_temp_sweep_cron" model="ir.cron">
            <field name="name">Database Versatile Backup - Stale Temp Sweep</field>
            <field name="model_id" ref="model_backup_job"/>
            <field name="state">code</field>
            <field name="code">model._cleanup_stale_temp_files()</field>
            <field name="priority">20</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>