#. module: soft_report_generator
#: model_terms:ir.ui.view,arch_db:soft_report_generator.soft_report_template_view_form
msgid "<strong>How to create your template:</strong>"
msgstr "<strong>Şablonunuzu nasıl oluşturursunuz:</strong>"

#. module: soft_report_generator
#: model_terms:ir.ui.view,arch_db:soft_report_generator.soft_report_template_view_form
msgid ""
"<strong>Optional.</strong> Upload a\n"
"                                    <strong>.docx</strong> cover page template.\n"
"                                    It will be rendered with the same record data\n"
"                                    and prepended to the PDF output.\n"
"                                    Use the same placeholder syntax as the main template."
msgstr ""
"<strong>İsteğe bağlı.</strong> Bir\n"
"                                    <strong>.docx</strong> kapak sayfası şablonu yükleyin.\n"
"                                    Aynı kayıt verisiyle oluşturulur\n"
"                                    ve çıktı PDF'inin başına eklenir.\n"
"                                    Ana şablonla aynı yer tutucu sözdizimini kullanın."

#. module: soft_report_generator
#: model_terms:ir.ui.view,arch_db:soft_report_generator.soft_report_template_view_form
msgid ""
"<strong>Placeholders detected!</strong>\n"
"                                    Map each one to the correct Odoo field path, then\n"
"                                    click <strong>Activate</strong>."
msgstr ""
"<strong>Yer tutucular bulundu!</strong>\n"
"                                    Her birini doğru Odoo alan yoluna eşleyip\n"
"                                    <strong>Etkinleştir</strong> düğmesine basın."

#. module: soft_report_generator
#: model_terms:ir.ui.view,arch_db:soft_report_generator.soft_report_template_view_form
msgid ""
"<strong>Tips:</strong>\n"
"                                    Use dot notation for related fields\n"
"                                    (<code>partner_id.city</code>).\n"
"                                    For loops, set <em>Field Path</em> to the One2many\n"
"                                    field (e.g. <code>order_line</code>) and check\n"
"                                    <em>Is Loop</em>. Child fields inside a loop should\n"
"                                    have a <em>Loop Parent</em> value."
msgstr ""
"<strong>İpuçları:</strong>\n"
"                                    İlişkili alanlar için nokta gösterimini kullanın\n"
"                                    (<code>partner_id.city</code>).\n"
"                                    Döngülerde <em>Alan Yolu</em> alanına One2many alanını\n"
"                                    girin (ör. <code>order_line</code>) ve\n"
"                                    <em>Döngü mü</em> kutusunu işaretleyin. Döngü içindeki alt alanlarda\n"
"                                    <em>Döngü Üstü</em> değeri olmalıdır."

