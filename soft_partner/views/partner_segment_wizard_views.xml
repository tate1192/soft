<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_segment_assign_form" model="ir.ui.view">
        <field name="name">partner.segment.assign.form</field>
        <field name="model">partner.segment.assign</field>
        <field name="arch" type="xml">
            <form string="Assign Partner Segment">
                <group>
                    <field name="segment_id" options="{'no_quick_create': True}"/>
                    <field name="partner_ids"
                           widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_apply"
                            type="object"
                            string="Assign"
                            class="btn-primary"/>
                    <button name="action_clear"
                            type="object"
                            string="Remove Segment"
                            class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Available in the Action menu of the contacts list and form -->
    <record id="action_partner_segment_assign" model="ir.actions.act_window">
        <field name="name">Assign Partner Segment</field>
        <field name="res_model">partner.segment.assign</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
