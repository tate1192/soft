<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_code_resequence_wizard" model="ir.ui.view">
        <field name="name">partner.code.resequence.wizard.form</field>
        <field name="model">partner.code.resequence.wizard</field>
        <field name="arch" type="xml">
            <form string="Resequence Partner Codes">
                <p>
                    All commercial partners will be renumbered in chronological
                    order (by create date). Contacts follow the code of their
                    company.
                </p>
                <p>
                    Format: <strong>P/XXXXX</strong>
                </p>
                <group>
                    <field name="total_count"/>
                </group>
                <footer>
                    <button name="action_resequence"
                            string="Start Resequence"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Available in the Action menu of the contacts list and form -->
    <record id="action_partner_code_resequence" model="ir.actions.act_window">
        <field name="name">Resequence Partner Codes</field>
        <field name="res_model">partner.code.resequence.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
        <field name="context">{'active_ids': active_ids, 'active_model': 'res.partner'}</field>
    </record>

</odoo>
