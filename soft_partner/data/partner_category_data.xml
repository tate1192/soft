<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="partner_category_bronze" model="partner.category">
        <field name="name">Bronze</field>
        <field name="code">bronze</field>
        <field name="sequence">10</field>
        <field name="color">1</field>
        <field name="description">Entry level classification.</field>
    </record>

    <record id="partner_category_silver" model="partner.category">
        <field name="name">Silver</field>
        <field name="code">silver</field>
        <field name="sequence">20</field>
        <field name="color">2</field>
        <field name="description">Regular customer or vendor.</field>
    </record>

    <record id="partner_category_gold" model="partner.category">
        <field name="name">Gold</field>
        <field name="code">gold</field>
        <field name="sequence">30</field>
        <field name="color">3</field>
        <field name="description">High value customer or vendor.</field>
    </record>

    <record id="partner_category_platinum" model="partner.category">
        <field name="name">Platinum</field>
        <field name="code">platinum</field>
        <field name="sequence">40</field>
        <field name="color">4</field>
        <field name="description">Strategic customer or vendor.</field>
    </record>

    <record id="partner_category_diamond" model="partner.category">
        <field name="name">Diamond</field>
        <field name="code">diamond</field>
        <field name="sequence">50</field>
        <field name="color">5</field>
        <field name="description">Key account.</field>
    </record>

    <record id="partner_category_company" model="partner.category">
        <field name="name">Company</field>
        <field name="code">company</field>
        <field name="sequence">5</field>
        <field name="color">7</field>
        <field name="description">Our own company record and the internal user (employee)
            contacts.</field>
    </record>

    <record id="partner_category_supplier" model="partner.category">
        <field name="name">Supplier</field>
        <field name="code">supplier</field>
        <field name="sequence">60</field>
        <field name="color">6</field>
        <field name="description">Vendors with no sales/contact trace, registered in Odoo as
            suppliers (supplier_rank &gt; 0 or a vendor bill). The purchase order module is not
            used.</field>
    </record>

</odoo>
