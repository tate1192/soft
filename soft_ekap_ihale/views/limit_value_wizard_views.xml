<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ekap_limit_value_wizard_form" model="ir.ui.view">
        <field name="name">ekap.limit.value.wizard.form</field>
        <field name="model">ekap.limit.value.wizard</field>
        <field name="arch" type="xml">
            <form string="Limit Value Calculation">
                <group>
                    <field name="tender_id" readonly="1"/>
                    <field name="tender_type" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="approximate_cost"/>
                    <field name="n_coefficient" invisible="tender_type == 'services'"/>
                    <field name="r_coefficient" invisible="tender_type != 'services'"/>
                </group>
                <group string="Bids Given in the Tender">
                    <field name="bid_text" nolabel="1" placeholder="One bid amount per line&#10;e.g. 12,345,678.90"/>
                </group>
                <group string="Result">
                    <field name="result_html" nolabel="1"/>
                </group>
                <field name="limit_value" invisible="1"/>
                <footer>
                    <button name="action_apply" type="object" string="Write the Limit Value on the Tender" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                    <em class="text-muted ms-3">The calculation follows Public Procurement General
                        Communiqué (KGT) 45.1.1 (works) / 79.1.2 (services); the N and R
                        coefficients are read from the parameter table.</em>
                </footer>
            </form>
        </field>
    </record>
</odoo>
