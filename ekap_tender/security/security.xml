<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ekap_module_category" model="ir.module.category">
        <field name="name">Tender / Bid</field>
        <field name="sequence">36</field>
    </record>

    <record id="privilege_ekap_user" model="res.groups.privilege">
        <field name="name">Tender User</field>
        <field name="category_id" ref="ekap_module_category"/>
    </record>

    <record id="group_ekap_user" model="res.groups">
        <field name="name">Tender User</field>
        <field name="privilege_id" ref="privilege_ekap_user"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_ekap_manager" model="res.groups.privilege">
        <field name="name">Tender Manager</field>
        <field name="category_id" ref="ekap_module_category"/>
    </record>

    <record id="group_ekap_manager" model="res.groups">
        <field name="name">Tender Manager</field>
        <field name="privilege_id" ref="privilege_ekap_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_ekap_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_ekap_tender_company" model="ir.rule">
            <field name="name">Tender: company record</field>
            <field name="model_id" ref="model_ekap_tender"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_bid_company" model="ir.rule">
            <field name="name">Bid: company record</field>
            <field name="model_id" ref="model_ekap_bid"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_tender_item_company" model="ir.rule">
            <field name="name">Tender item: company record</field>
            <field name="model_id" ref="model_ekap_tender_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_bid_line_company" model="ir.rule">
            <field name="name">Bid item: company record</field>
            <field name="model_id" ref="model_ekap_bid_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_analysis_company" model="ir.rule">
            <field name="name">Analysis: company record</field>
            <field name="model_id" ref="model_ekap_analysis"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_analysis_line_company" model="ir.rule">
            <field name="name">Analysis input: company record</field>
            <field name="model_id" ref="model_ekap_analysis_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_labor_calc_company" model="ir.rule">
            <field name="name">Labour calculation: company record</field>
            <field name="model_id" ref="model_ekap_labor_calc"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_labor_rate_company" model="ir.rule">
            <field name="name">Minimum wage period: company record</field>
            <field name="model_id" ref="model_ekap_labor_rate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>

        <record id="rule_ekap_parameter_company" model="ir.rule">
            <field name="name">Parameter: global or company record</field>
            <field name="model_id" ref="model_ekap_parameter"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('group_ekap_user'))]"/>
        </record>
    </data>
</odoo>
