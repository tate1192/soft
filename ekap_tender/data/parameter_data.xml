<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Rates and coefficients the calculation engine reads.

        noupdate="1" on purpose: a user who corrects a rate (or adds the new year's
        coefficient) must not have it overwritten by a later module update. Each row
        carries the source it came from, so a bid priced last year can be explained.
    -->
    <data noupdate="1">
        <record id="param_works_n_other" model="ekap.parameter">
            <field name="code">WORKS_N_OTHER</field>
            <field name="value">1.20</field>
            <field name="date_from">2010-12-29</field>
            <field name="source">KGT 45.1.1.1 (other construction works)</field>
        </record>
        <record id="param_works_n_superstructure" model="ekap.parameter">
            <field name="code">WORKS_N_SUPERSTRUCTURE</field>
            <field name="value">1.00</field>
            <field name="date_from">2010-12-29</field>
            <field name="source">KGT 45.1.1.1 (superstructure, electrical, mechanical installation, telecommunication)</field>
        </record>
        <record id="param_analysis_profit_overhead" model="ekap.parameter">
            <field name="code">ANALYSIS_PROFIT_OVERHEAD</field>
            <field name="value">0.25</field>
            <field name="date_from">2003-06-11</field>
            <field name="source">YİUY art.11 and public analyses (10% profit + 15% overhead)</field>
        </record>
        <record id="param_new_unit_price_profit" model="ekap.parameter">
            <field name="code">NEW_UNIT_PRICE_PROFIT</field>
            <field name="value">0.10</field>
            <field name="date_from">2025-09-01</field>
            <field name="source">YİGŞ art.22 (new unit price profit rate)</field>
        </record>
        <record id="param_new_unit_price_overhead" model="ekap.parameter">
            <field name="code">NEW_UNIT_PRICE_OVERHEAD</field>
            <field name="value">0.15</field>
            <field name="date_from">2025-09-01</field>
            <field name="source">YİGŞ art.22 (new unit price overhead cap)</field>
        </record>
        <record id="param_provisional_security" model="ekap.parameter">
            <field name="code">PROVISIONAL_SECURITY</field>
            <field name="value">0.03</field>
            <field name="date_from">2003-01-04</field>
            <field name="source">Law 4734 art.33 (not less than 3% of the bid)</field>
        </record>
        <record id="param_final_security" model="ekap.parameter">
            <field name="code">FINAL_SECURITY</field>
            <field name="value">0.06</field>
