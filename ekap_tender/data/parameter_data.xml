            <field name="code">STAMP_DUTY_AWARD</field>
            <field name="value">0.00569</field>
            <field name="date_from">2020-01-01</field>
            <field name="source">Law 488 Stamp Duty Law table (1) II/2 (5.69 per mille)</field>
        </record>
