#: model:ir.model.fields,help:sale_product_image.field_res_config_settings__show_image_in_report
msgid "Print a product image column in the quotation and sale order reports. The column is left out when no line carries an image."
msgstr "Teklif ve satış siparişi raporlarında ürün görseli kolonu yazdırır. Hiçbir satırda görsel yoksa kolon yazdırılmaz."

#. module: sale_product_image
#: model_terms:ir.ui.view,arch_db:sale_product_image.report_saleorder_inherit
