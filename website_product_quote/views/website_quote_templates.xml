    <template id="product_quote_button_and_modal" inherit_id="website_sale.product"
              name="Product Quote Button and Modal">
        <!--        <xpath expr="//div[@id='product_details']//section[@id='product_add_to_cart']" position="after">-->
        <!--            <div id="product_request_quote" class="mt-3">-->
        <!--                <button type="button" class="btn btn-secondary btn_cta w-100" data-bs-toggle="modal" data-bs-target="#quoteModal">-->
        <!--                    <i class="fa fa-file-text-o me-1"/> Teklif Talep Et-->
        <!--                </button>-->
        <!--            </div>-->
        <!--        </xpath>-->

        <!-- v19: o_wsale_cta_wrapper artik ayri bir sablonda (website_sale.cta_wrapper)
             t-call ile cagriliyor; website_sale.product icinden bulunamaz.
             Bu yuzden cagriyi (t-call) bizim CTA blogumuzla degistiriyoruz.

             DIKKAT: t-call'u replace ettigimiz icin website_sale_stock'un bu sablona
             ekledigi hook dugumleri kayboluyor. JS bunlari korumasiz sorguluyor
             (website_sale_stock/static/src/js/variant_mixin.js ->
             this.el.querySelector('div.availability_messages').append(...)),
             eksik oldugunda varyant degistirirken
             "Cannot read properties of null (reading 'append')" hatasi cikiyor.
             Bu yuzden core'un ekledigi hook'lari burada elle birakiyoruz. -->
        <xpath expr="//t[@t-call='website_sale.cta_wrapper']" position="replace">
            <div id="o_wsale_cta_wrapper" class="d-flex oe_structure oe_structure_solo">
                <div class="availability_messages o_not_editable"/>
                <input t-if="is_view_active('website_sale_stock.website_sale_stock_product')"
                       id="wsale_user_email" type="hidden" t-att-value="user_email"/>
                <section class="s_text_block" data-snippet="s_text_block" data-name="Text">
                    <div class="container">
                        <button type="button" class="btn btn-primary btn_cta" data-bs-toggle="modal"
                                data-bs-target="#quoteModal">
                            Fiyat Teklifi İste
                        </button>
                    </div>
                </section>
            </div>
        </xpath>

        <!--        <xpath expr="//div[@id='product_details']//div[hasclass('alert-info')]" position="replace"/>-->

        <!-- Modal Penceresini Sayfaya Ekle (Genellikle body sonuna yakın bir yere eklenir) -->
        <!-- Bu xpath, ana ürün konteynerinin sonuna ekler -->
        <xpath expr="//div[@id='product_details']" position="inside">
            <div class="modal fade" id="quoteModal" tabindex="-1" aria-labelledby="quoteModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <form id="quoteForm" action="/shop/quote/submit" method="POST">
                            <!-- CSRF Token (Güvenlik için Önemli!) -->
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <!-- Ürün ID'sini gizli alan olarak gönder -->
                            <!-- product.product_variant_id.id seçili olan varyantın ID'sini alır -->
                            <input type="hidden" name="product_id" t-att-value="product.product_variant_id.id"/>

                            <div class="modal-header">
                                <h5 class="modal-title" id="quoteModalLabel">
                                    <t t-esc="product.name"/>
                                    İçin Teklif Talebi
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                            </div>
                            <div class="modal-body">
                                <p class="text-muted">Lütfen bilgileri doldurun. En kısa sürede size dönüş yapacağız.
                                </p>
                                <div class="mb-3">
                                    <label for="quoteCompany" class="form-label">Firma Adı
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" id="quoteCompany" name="company"
                                           required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="quoteName" class="form-label">Adınız Soyadınız
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" class="form-control" id="quoteName" name="name"
                                           required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="quoteEmail" class="form-label">E-posta Adresiniz
                                        <span class="text-danger">*</span>
                                    </label>
                                    <input type="email" class="form-control" id="quoteEmail" name="email"
                                           required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="quotePhone" class="form-label">Telefon Numaranız</label>
                                    <input type="tel" class="form-control" id="quotePhone" name="phone" required="required"/>
                                </div>
                                <div class="mb-3">
                                    <label for="quoteQuantity" class="form-label">Miktar</label>
                                    <!-- default_code ürün referansı için bir örnek -->
                                    <input type="number" class="form-control" id="quoteQuantity" name="quantity"
                                           placeholder="Örn: 1" min="1"/>
                                </div>
                                <div class="mb-3">
                                    <label for="quoteDescription" class="form-label">Ek Notlar / Açıklama</label>
                                    <textarea class="form-control" id="quoteDescription" name="description" rows="3"/>
                                </div>
                                <small class="text-danger">* Zorunlu alanlar</small>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                                <!-- Formu gönderecek buton -->
                                <button type="submit" class="btn btn-primary">Teklif İsteğini Gönder</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="quote_thank_you" name="Quote Request Thank You">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure oe_empty">
                <section class="py-5">
                    <div class="container">
                        <div class="row">
                            <div class="col-md-8 offset-md-2 text-center">
                                <h1>Teşekkür Ederiz!</h1>
                                <p class="lead">Teklif talebiniz başarıyla alınmıştır.</p>
                                <t t-if="lead">
                                    <p>Referans Numaranız:
                                        <strong t-field="lead.id"/>
                                    </p>
                                    <p>En kısa sürede sizinle iletişime geçeceğiz.</p>
                                </t>
                                <t t-if="product">
                                    <p>Talep Edilen Ürün:
                                        <strong t-field="product.display_name"/>
                                    </p>
                                </t>
                                <p>
                                    <a href="/shop" class="btn btn-primary mt-3">Ürün İncelemeye Devam Et</a>
                                </p>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

</odoo>