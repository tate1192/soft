<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Contents of the card; the popover service wraps it in the element that
        carries the Bootstrap `.popover` styling and the arrow. The classes
        `popover-header` / `popover-body` / `popover-footer` are the ones that
        styling expects.
    -->
    <t t-name="soft_gantt.GanttPopover">
        <div class="o_gantt_soft_popover">
            <div class="popover-header d-flex justify-content-between align-items-start gap-2">
                <span class="o_gantt_soft_popover_title" t-esc="props.title"/>
                <button type="button" class="btn-close" t-on-click="props.close" aria-label="Close"/>
            </div>
            <div class="popover-body">
                <dl class="o_gantt_soft_popover_fields mb-0" t-if="fields.length">
                    <t t-foreach="fields" t-as="field" t-key="field_index">
                        <dt t-esc="field.label"/>
                        <dd t-esc="field.value"/>
                    </t>
                </dl>
            </div>
            <div class="popover-footer" t-if="props.open or buttons.length">
                <!-- The actions of the view first, in arch order, then the
                     form as the explicit navigation: acting on a record does
                     not leave the chart. -->
                <button t-foreach="buttons" t-as="button" t-key="button.key"
                        type="button"
                        t-attf-class="o_gantt_soft_popover_action btn btn-sm {{ button.className || 'btn-secondary' }}"
                        t-on-click="() => button.onClick()">
                    <i t-if="button.icon"
                       t-attf-class="{{ button.icon }} {{ button.label ? 'me-1' : '' }}"/>
                    <t t-if="button.label" t-esc="button.label"/>
                </button>
                <button t-if="props.open" type="button" class="btn btn-primary btn-sm" t-on-click="() => this.props.open()">
                    <i class="fa fa-external-link me-1"/>Open
                </button>
            </div>
        </div>
    </t>

</templates>
