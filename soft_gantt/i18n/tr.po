"Field %(field)r on %(comodel)s, used as group_avatar in a gantt_soft view, "
"must be a binary image field, not %(type)s."
msgstr ""
"%(comodel)s modelindeki %(field)r alanı, gantt_soft görünümünde group_avatar"
" olarak kullanıldığında binary image alanı olmalıdır; %(type)s değil."

#. module: soft_gantt
#. odoo-python
#: code:addons/soft_gantt/models/ir_ui_view.py:0
msgid ""
"Field %(field)r used as %(attribute)s in a gantt_soft view must be of type "
"%(types)s, not %(type)s."
msgstr ""
"Bir gantt_soft görünümünde %(attribute)s olarak kullanılan %(field)r alanı "
"%(types)s türünde olmalı, %(type)s değil."

#. module: soft_gantt
#. odoo-python
#: code:addons/soft_gantt/models/ir_ui_view.py:0
msgid ""
"Field %(field)r used as %(attribute)s in a gantt_soft view must be stored or"
" searchable: the window is read with a domain on it."
msgstr ""
"%(field)r alanı, gantt_soft görünümünde %(attribute)s olarak kullanıldığında"
" stored veya searchable olmalıdır; pencere bu alan üzerinde domain ile "
"okunuyor."

#. module: soft_gantt
#. odoo-python
#: code:addons/soft_gantt/models/ir_ui_view.py:0
